# =============================================================================
# HBM Article Automation - Backend Environment Configuration (Template)
# Copy this file to .env and replace placeholder values with your real credentials.
# =============================================================================

# Database
# For local development with SQLite, leave empty or set to sqlite:///hbm_automation.db
# For Render deployment with Persistent Disk, set to sqlite:////var/data/hbm_automation.db
DATABASE_URL=

# CORS & Frontend Origins (Comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Render Persistent Disk Mount Path (Default: /var/data)
RENDER_DISK_PATH=/var/data

# Security & Initial Admin Provisioning
# Generate a 32-byte url-safe base64 key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key_here
ADMIN_EMAIL=admin@espialsolutions.com
ADMIN_INITIAL_PASSWORD=your_secure_admin_initial_password_here

# Basecamp 3 OAuth 2.0
BASECAMP_CLIENT_ID=your_basecamp_oauth_client_id_here
BASECAMP_CLIENT_SECRET=your_basecamp_oauth_client_secret_here
BASECAMP_REDIRECT_URI=http://localhost:8000/api/basecamp/callback
BASECAMP_ACCOUNT_ID=

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Destination WordPress (Multi-Site Configuration)
# Note: Publishing is strictly draft-only. Production writes to homebusinessmag.com are hard-blocked.
WORDPRESS_SITE_1_NAME=EspialSolutions
WORDPRESS_SITE_1_URL=https://espialsolutions.com
WORDPRESS_SITE_1_USERNAME=your_wordpress_username_here
WORDPRESS_SITE_1_APP_PASSWORD=your_wordpress_application_password_here
WORDPRESS_DEFAULT_AUTHOR=pratiksha_dev

# Envato Market / PhotoDune Image Provider
ENVATO_API_TOKEN=your_envato_api_bearer_token_here
ENVATO_API_URL=https://api.envato.com/v1/discovery/search/search/item
ENVATO_SITE=photodune.net

# Yoast SEO Node.js Sidecar
BCWP_SECRET=your_random_secret_matching_sidecar_here
YOAST_SIDECAR_URL=http://localhost:3939/analyze

# Policy & Workflow Settings
ALLOW_ARTICLES_WITHOUT_IMAGE=False
